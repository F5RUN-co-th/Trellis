# Tick data (very large files)
Data/*.csv
Data/*.bak

# Compiled EA / Scripts (compiled artifacts)
Experts/*.ex5
Scripts/*.ex5

# Logs
compile.log
*.log
# record ของ Scripts/ad4_cert_out_v2/ (log ของ run บน .19) ต้อง track — คู่กับ .gitattributes -text
!Scripts/ad4_cert_out_v2/**/*.log

# MetaEditor temp files
*.tmp
*.bak

# Python cache
__pycache__/
*.pyc

# OS files
Thumbs.db
.DS_Store

# Claude Code local settings (personal overrides)
.claude/settings.local.json
